# ---- CourseWorks / Canvas -------------------------------------------------
# Account -> Settings -> "+ New Access Token" at courseworks2.columbia.edu.
# Verified reachable without any bot challenge, unlike the rest of columbia.edu.
CANVAS_BASE_URL=https://courseworks2.columbia.edu
CANVAS_ACCESS_TOKEN=

# ---- Mail -----------------------------------------------------------------
# none        refuse all mail tools (default until you've checked what CUIT allows)
# apple_mail  AppleScript against Mail.app — needs no admin approval
# gmail_api   Google Workspace OAuth — may be blocked for third-party clients
GMAIL_BACKEND=none

# Only for GMAIL_BACKEND=gmail_api:
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Telegram -------------------------------------------------------------
# Token from @BotFather. Owner id from @userinfobot — the bridge refuses to
# start without it, so the bot can never answer a stranger.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---- Runtime --------------------------------------------------------------
# Absolute path if launchd can't find claude on PATH (usually ~/.local/bin/claude).
CLAUDE_BIN=claude
COLUMBIA_WORKDIR=/Users/jeremylevitt/workspace/Columbia
CLAUDE_TIMEOUT_MS=900000
CLAUDE_PERMISSION_MODE=dontAsk

# Vergil is a client-rendered app behind Cloudflare; if the live search URL
# differs from the default, set it here instead of editing code.
# VERGIL_SEARCH_URL=https://vergil.registrar.columbia.edu/#/search?q={query}&term={term}
VERGIL_HEADLESS=0
