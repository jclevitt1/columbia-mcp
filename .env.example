# ---- CourseWorks / Canvas -------------------------------------------------
# Account -> Settings -> "+ New Access Token" at courseworks2.columbia.edu.
# Verified reachable without any bot challenge, unlike the rest of columbia.edu.
CANVAS_BASE_URL=https://courseworks2.columbia.edu
CANVAS_ACCESS_TOKEN=

# ---- Mail -----------------------------------------------------------------
# none        refuse all mail tools (default until you've checked what CUIT allows)
# apple_mail  AppleScript against Mail.app — needs no admin approval
# gmail_api   Google Workspace OAuth — may be blocked for third-party clients
GMAIL_BACKEND=none

# Only for GMAIL_BACKEND=gmail_api. The same consent also covers Drive, Docs,
# Sheets and Calendar (enable all five APIs on the Cloud project).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ---- Calendar -------------------------------------------------------------
# IANA zone used to interpret and display event times.
CALENDAR_TIMEZONE=America/New_York

# ---- Telegram -------------------------------------------------------------
# Token from @BotFather. Owner id from @userinfobot — the bridge refuses to
# start without it, so the bot can never answer a stranger.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---- Runtime --------------------------------------------------------------
# Absolute path if launchd can't find claude on PATH (usually ~/.local/bin/claude).
CLAUDE_BIN=claude
COLUMBIA_WORKDIR=/Users/jeremylevitt/workspace/Columbia
CLAUDE_TIMEOUT_MS=900000
CLAUDE_PERMISSION_MODE=dontAsk

# Course search uses doc.search.columbia.edu (public, verified). Set to 1 to
# run Chromium headless — fine for search, but leave it 0 for `vergil-login`,
# which needs a visible window for Duo.
VERGIL_HEADLESS=0

# Extra built-in tools for the Telegram session, comma separated.
# Bash is intentionally NOT on by default: this agent reads email and web
# pages, so a prompt injection with shell access becomes a machine-level
# problem. Turn it on knowingly (BRIDGE_EXTRA_TOOLS=Bash) rather than reaching
# for --dangerously-skip-permissions, which drops the check on everything.
BRIDGE_EXTRA_TOOLS=

# Set by the launchd plist, not here. When present, `\update` exits after
# pulling and lets launchd's KeepAlive restart the bridge; when absent (you ran
# `npm run bridge` by hand) the bridge re-execs itself instead. Leave unset.
# BRIDGE_SUPERVISOR=launchd
